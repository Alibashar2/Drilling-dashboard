# Copy to .env.local and fill in to run against Supabase.
# Leave both empty to use the embedded PostgreSQL (PGlite) database stored in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional AI assistance for the report reader (run `node server/llm-proxy.mjs` with ANTHROPIC_API_KEY set).
# VITE_LLM_PROXY_URL=http://localhost:8787

# Reserved for the future Power BI REST connector (requires a backend proxy; see docs/ARCHITECTURE.md).
# VITE_POWERBI_PROXY_URL=
